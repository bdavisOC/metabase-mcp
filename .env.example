# Metabase Configuration
METABASE_URL=your-metabase-url
METABASE_USER_EMAIL=your-email@example.com
METABASE_PASSWORD=your-password
# METABASE_API_KEY=your-api-key
# METABASE_SESSION_TOKEN=your-session-token  # for SSO-only instances: the metabase.SESSION cookie value
METABASE_HTTP_TIMEOUT=30.0

# Either use API_KEY or EMAIL+PASSWORD for authentication
# API_KEY takes precedence if both are provided
# SESSION_TOKEN is used as-is (no login); it expires, so refresh it when calls start returning 401
